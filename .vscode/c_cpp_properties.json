{
  "configurations": [
    {
      "browse": {
        "databaseFilename": "${workspaceFolder}/.vscode/browse.vc.db",
        "limitSymbolsToIncludedHeaders": true
      },
      "includePath": [
        "${workspaceFolder}/src/odin_ros_driver/include/**",
        "${workspaceFolder}/install/odin_ros_driver/include/**",
        "/opt/ros/humble/include/**"
      ],
      "name": "ros2",
      "intelliSenseMode": "gcc-x64",
      "compilerPath": "/usr/bin/c++",
      "cStandard": "gnu11",
      "cppStandard": "c++17",
      "compileCommands": "${workspaceFolder}/build/odin_ros_driver/compile_commands.json"
    }
  ],
  "version": 4
}
